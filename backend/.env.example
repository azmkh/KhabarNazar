PROJECT_NAME="KhabarNazar Backend"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"

# Database Configuration (PostgreSQL) - REQUIRED
# Format: postgresql+psycopg://<username>:<password>@<host>:<port>/<dbname>
# For quick local work without PostgreSQL, SQLite also works: sqlite:///./khabarnazar.db
# (relative SQLite paths are resolved from the backend/ folder)
DATABASE_URL=

# Authentication / Security - REQUIRED
# Generate a secret with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Failed-login limits: lock out a device+email after this many failures, or a
# device after this many failures across all emails, for LOGIN_LOCKOUT_MINUTES.
LOGIN_MAX_FAILURES_PER_ACCOUNT=5
LOGIN_MAX_FAILURES_PER_CLIENT=20
LOGIN_LOCKOUT_MINUTES=15

# File Uploads (relative paths are resolved from the backend/ folder)
UPLOAD_DIR="uploads"
MAX_UPLOAD_SIZE_MB=10
ALLOWED_IMAGE_TYPES='["image/jpeg", "image/png", "image/webp"]'

# Combined risk score weights (text fake-probability vs image manipulation score)
TEXT_RISK_WEIGHT=0.7
IMAGE_RISK_WEIGHT=0.3

# CORS - only needed for browsers (Expo web / Swagger from another origin).
# Native Expo apps on a phone or emulator are not affected by CORS.
CORS_ORIGINS='["http://localhost:8081", "http://localhost:19006"]'
