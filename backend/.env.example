PROJECT_NAME="KhabarNazar Backend"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"

# Database Configuration (PostgreSQL) - REQUIRED
# Format: postgresql+psycopg://<username>:<password>@<host>:<port>/<dbname>
# For quick local work without PostgreSQL, SQLite also works: sqlite:///./khabarnazar.db
# (relative SQLite paths are resolved from the backend/ folder)
DATABASE_URL=
# Used only by `pytest --postgres`; its name must end in "_test" (it is wiped on every run).
# scripts/setup_postgres.py fills in both values.
TEST_DATABASE_URL=

# Authentication / Security - REQUIRED
# Generate a secret with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Failed-login limits: lock out a device+email after this many failures, or a
# device after this many failures across all emails, for LOGIN_LOCKOUT_MINUTES.
LOGIN_MAX_FAILURES_PER_ACCOUNT=5
LOGIN_MAX_FAILURES_PER_CLIENT=20
LOGIN_LOCKOUT_MINUTES=15

# File Uploads (relative paths are resolved from the backend/ folder)
UPLOAD_DIR="uploads"
MAX_UPLOAD_SIZE_MB=10
ALLOWED_IMAGE_TYPES='["image/jpeg", "image/png", "image/webp"]'

# Largest decoded image accepted (width x height), against decompression bombs
MAX_IMAGE_PIXELS=40000000

# Image pipeline: OCR text is "usable" (image-with-text branch) with at least this many
# letters and this average OCR confidence; otherwise the AI-generated vs real branch runs.
OCR_MIN_LETTERS=10
OCR_MIN_CONFIDENCE=0.3

# Load the AI models in the background at startup (false = load on first request)
PRELOAD_MODELS=true

# Text XLM-R models (weights are downloaded separately with text_module/download_models.py;
# leave paths empty for defaults). Urdu uses its checkpoint's training limit: 256 tokens for
# release urdu-xlmr-v1, 64 for the older text-model-v1. Roman Urdu defaults to 512.
# The legacy KHABARNAZAR_XLMR_MAX_LEN overrides Roman Urdu only; per-language values win.
# KHABARNAZAR_URDU_XLMR_DIR=
# KHABARNAZAR_ROMAN_XLMR_DIR=
# KHABARNAZAR_URDU_XLMR_MAX_LEN=64
# KHABARNAZAR_ROMAN_XLMR_MAX_LEN=512
# KHABARNAZAR_XLMR_MAX_LEN=512
# Urdu text longer than this many words uses the long-article TF-IDF model (in git).
# KHABARNAZAR_LONG_TEXT_WORDS=150
# KHABARNAZAR_TEXT_MODEL_PATH=

# CORS - only needed for browsers (Expo web / Swagger from another origin).
# Native Expo apps on a phone or emulator are not affected by CORS.
CORS_ORIGINS='["http://localhost:8081", "http://localhost:19006"]'
