{
  "expo": {
    "name": "KhabarNazar",
    "slug": "KhabarNazar",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "khabarnazar",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#111827"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "KhabarNazar needs photo access to analyze news screenshots you choose from your library.",
          "cameraPermission": "KhabarNazar can use the camera when you capture a news image to analyze."
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#111827"
        }
      ],
      "expo-status-bar",
      "expo-web-browser",
      "@react-native-vector-icons/lucide",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
